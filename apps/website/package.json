{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "panda codegen && (pnpm --filter @core/ui dev & panda --watch --outfile styles.css & vite dev)",
    "build": "panda codegen && panda cssgen --outfile styles.css && vite build",
    "typecheck": "tsc -p .",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@core/theme": "workspace:*",
    "@core/ui": "workspace:*",
    "@fontsource-variable/onest": "^5.3.1",
    "@payloadcms/db-mongodb": "4.0.0-beta.3",
    "@payloadcms/graphql": "4.0.0-beta.3",
    "@payloadcms/plugin-mcp": "4.0.0-beta.3",
    "@payloadcms/richtext-lexical": "4.0.0-beta.3",
    "@payloadcms/tanstack-start": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.0",
    "@vitejs/plugin-rsc": "^0.5.38",
    "graphql": "^16.14.2",
    "payload": "4.0.0-beta.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "nitro": "3.0.260903-beta",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
